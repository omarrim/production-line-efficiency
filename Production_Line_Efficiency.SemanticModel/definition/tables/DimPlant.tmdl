	partition DimPlant = m
		mode: import
		source =
				let
				    Source = Csv.Document(File.Contents(DossierDonnees & "DimPlant.csv"), [Delimiter=",", Encoding=65001, QuoteStyle=QuoteStyle.Csv]),
				    Promoted = Table.PromoteHeaders(Source, [PromoteAllScalars=true]),
				    Typed = Table.TransformColumnTypes(Promoted, {{"PlantID", Int64.Type}, {"PlantName", type text}, {"Country", type text}, {"Region", type text}, {"City", type text}})
				in
				    Typed

	annotation PBI_ResultType = Table


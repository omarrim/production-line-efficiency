		lineageTag: 147d4c00-13db-4208-9659-a3c186dce3cc

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Defect Rate PP' = CALCULATE([Defect Rate], DATEADD(DimDate[Date], -30, DAY))
		formatString: 0.0%
		lineageTag: 1eb1b2db-6774-4e7f-9c73-32cdbd5f5aae

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Defect Rate Variation' = [Defect Rate] - [Defect Rate PP]
		formatString: +0.0%;-0.0%;0.0%
		lineageTag: 088f6fef-ae32-42ee-a5ac-55e063b857e8

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Production Yield' = DIVIDE(SUM(FactProduction[GoodUnits]), SUM(FactProduction[TotalUnitsProduced]))
		formatString: 0%
		lineageTag: a75b1b12-91df-472d-b7a6-4f187b8446d1

		annotation PBI_FormatHint = {"isCustom":true}

	measure 'Production Yield PP' = CALCULATE([Production Yield], DATEADD(DimDate[Date], -30, DAY))

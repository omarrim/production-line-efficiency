	/// Mois selectionne via le slicer deconnecte MonthPicker. A utiliser dans les KPI cards.
	measure 'OEE Selected' =
			VAR Sel = SELECTEDVALUE(MonthPicker[YearMonth])
			RETURN CALCULATE([OEE], REMOVEFILTERS(DimDate), DimDate[YearMonth] = Sel)
		formatString: 0.0%
		lineageTag: 1fddfcac-7394-4937-a842-3ef29e58c96b

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Defect Rate Selected' =
			VAR Sel = SELECTEDVALUE(MonthPicker[YearMonth])
			RETURN CALCULATE([Defect Rate], REMOVEFILTERS(DimDate), DimDate[YearMonth] = Sel)
		formatString: 0.0%
		lineageTag: c71f50d1-e056-4662-a3ae-afd4d18193b1

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Production Yield Selected' =
			VAR Sel = SELECTEDVALUE(MonthPicker[YearMonth])
			RETURN CALCULATE([Production Yield], REMOVEFILTERS(DimDate), DimDate[YearMonth] = Sel)
		formatString: 0%
		lineageTag: a35b4ac9-9a34-492f-bf5b-ec2f9a9d5fd3

		annotation PBI_FormatHint = {"isCustom":true}

	measure 'Total Downtime Hours Selected' =
			VAR Sel = SELECTEDVALUE(MonthPicker[YearMonth])
			RETURN CALCULATE([Total Downtime Hours], REMOVEFILTERS(DimDate), DimDate[YearMonth] = Sel)
		formatString: 0
		lineageTag: b3ea8596-a46f-4525-a373-fb17fcf53c57

	/// Variation Mois sur Mois (mois selectionne vs mois precedent)
	measure 'OEE Variation MoM' =
			VAR Sel = SELECTEDVALUE(MonthPicker[YearMonth])
			VAR SelStart = CALCULATE(MIN(DimDate[Date]), ALL(DimDate), DimDate[YearMonth] = Sel)
			VAR PrevEnd = SelStart - 1
			VAR PrevStart = DATE(YEAR(PrevEnd), MONTH(PrevEnd), 1)
			VAR Cur = [OEE Selected]
			VAR Prev = CALCULATE([OEE], REMOVEFILTERS(DimDate), DimDate[Date] >= PrevStart && DimDate[Date] <= PrevEnd)
			RETURN Cur - Prev
		formatString: +0.0%;-0.0%;0.0%
		lineageTag: 840c362b-fae0-43fa-ba2c-709eb5d39eb6

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Defect Rate Variation MoM' =
			VAR Sel = SELECTEDVALUE(MonthPicker[YearMonth])
			VAR SelStart = CALCULATE(MIN(DimDate[Date]), ALL(DimDate), DimDate[YearMonth] = Sel)
			VAR PrevEnd = SelStart - 1
			VAR PrevStart = DATE(YEAR(PrevEnd), MONTH(PrevEnd), 1)
			VAR Cur = [Defect Rate Selected]
			VAR Prev = CALCULATE([Defect Rate], REMOVEFILTERS(DimDate), DimDate[Date] >= PrevStart && DimDate[Date] <= PrevEnd)
			RETURN Cur - Prev
		formatString: +0.0%;-0.0%;0.0%
		lineageTag: 06a778c3-cb90-4301-bdb1-2c01ada71c88

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Production Yield Variation MoM' =
			VAR Sel = SELECTEDVALUE(MonthPicker[YearMonth])
			VAR SelStart = CALCULATE(MIN(DimDate[Date]), ALL(DimDate), DimDate[YearMonth] = Sel)
			VAR PrevEnd = SelStart - 1
			VAR PrevStart = DATE(YEAR(PrevEnd), MONTH(PrevEnd), 1)
			VAR Cur = [Production Yield Selected]
			VAR Prev = CALCULATE([Production Yield], REMOVEFILTERS(DimDate), DimDate[Date] >= PrevStart && DimDate[Date] <= PrevEnd)
			RETURN Cur - Prev
		formatString: +0.0%;-0.0%;0.0%
		lineageTag: 4e5207f1-df19-42e0-83b3-af0aa3523abc

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Downtime Variation MoM' =
			VAR Sel = SELECTEDVALUE(MonthPicker[YearMonth])
			VAR SelStart = CALCULATE(MIN(DimDate[Date]), ALL(DimDate), DimDate[YearMonth] = Sel)
			VAR PrevEnd = SelStart - 1
			VAR PrevStart = DATE(YEAR(PrevEnd), MONTH(PrevEnd), 1)
			VAR Cur = [Total Downtime Hours Selected]
			VAR Prev = CALCULATE([Total Downtime Hours], REMOVEFILTERS(DimDate), DimDate[Date] >= PrevStart && DimDate[Date] <= PrevEnd)
			RETURN Cur - Prev
		formatString: +0.0;-0.0;0.0 hours
		lineageTag: dca78ce5-7ebd-477b-b0f6-7bab16f3df14

		annotation PBI_FormatHint = {"isCustom":true}

	/// Filtre pour les charts trailing 10 mois.
	/// A glisser dans le panneau "Filtres sur ce visuel" du line/bar chart,
	/// puis selectionner "est 1".
	measure 'Is In Trailing 10M' =
			VAR Sel = SELECTEDVALUE(MonthPicker[YearMonth])
			VAR EndDate = CALCULATE(MAX(DimDate[Date]), ALL(DimDate), DimDate[YearMonth] = Sel)
			VAR StartDate = EOMONTH(EndDate, -10) + 1
			VAR RowDate = MAX(DimDate[Date])
			RETURN IF(RowDate >= StartDate && RowDate <= EndDate, 1)
		formatString: 0
		lineageTag: 99870e28-699f-4cee-921b-92099d5747f3

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	/// Valeur de la metrique de la ligne courante de ProgressMetrics. A mettre dans le tableau progress bars.
	measure 'Progress Value' =
			VAR M = SELECTEDVALUE(ProgressMetrics[Metric])
			RETURN
			SWITCH(
				M,
				"Schedule Attainment",    [Schedule Attainment Selected],
				"Maintenance Compliance", [Maintenance Compliance Selected],
				"Stock Health",           [Stock Health Selected]
			)
		formatString: 0.0%
		lineageTag: 5e40e995-7120-4e7e-8191-7007aa715333

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	/// Couleur hex de la barre de progression selon le palier (a utiliser via fx -> Field value).
	measure 'Progress Color' =
			VAR V = [Progress Value]
			RETURN
			SWITCH(
				TRUE(),
				V < 0.5,  "#6B2FB3",
				V < 0.75, "#9B5DE5",
				V < 0.9,  "#E0AAFF",
				"#F4C95D"
			)
		lineageTag: e9b0a74e-4a68-4bcc-bb7d-78534add6331

	/// Quality du mois selectionne via MonthPicker.
	measure 'Quality Selected' =
			VAR Sel = SELECTEDVALUE(MonthPicker[YearMonth])
			RETURN CALCULATE([Quality], REMOVEFILTERS(DimDate), DimDate[YearMonth] = Sel)
		formatString: 0.0%
		lineageTag: 02e2f350-b480-4e8e-bb55-573c6dd702f8

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	/// Schedule Attainment = unites produites / unites planifiees, sur le mois selectionne.
	measure 'Schedule Attainment Selected' =
			VAR Sel = SELECTEDVALUE(MonthPicker[YearMonth])
			RETURN CALCULATE(
				DIVIDE(SUM(FactProduction[TotalUnitsProduced]), SUM(FactProduction[TargetUnits])),
				REMOVEFILTERS(DimDate),
				DimDate[YearMonth] = Sel
			)
		formatString: 0.0%
		lineageTag: 92d3ca99-5ac6-4429-84b8-37174cf2e7a9

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	/// Maintenance Compliance = % d'alertes maintenance non "Overdue" sur le mois selectionne. Renvoie 100% si aucune alerte.
	measure 'Maintenance Compliance Selected' =
			VAR Sel = SELECTEDVALUE(MonthPicker[YearMonth])
			VAR TotalAlerts = CALCULATE(COUNTROWS(FactMaintenance), REMOVEFILTERS(DimDate), DimDate[YearMonth] = Sel)
			VAR Overdue = CALCULATE(COUNTROWS(FactMaintenance), REMOVEFILTERS(DimDate), DimDate[YearMonth] = Sel, FactMaintenance[Status] = "Overdue")
			RETURN
			IF(
				ISBLANK(TotalAlerts) || TotalAlerts = 0,
				1,
				1 - DIVIDE(Overdue, TotalAlerts)
			)
		formatString: 0.0%
		lineageTag: 1b139d4f-ee4c-4a20-b575-72ad54f6c4ec

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	/// Stock Health = % SKUs en statut "OK" (au-dessus du reorder point) sur le mois selectionne.
	measure 'Stock Health Selected' =
			VAR Sel = SELECTEDVALUE(MonthPicker[YearMonth])
			VAR TotalRows = CALCULATE(COUNTROWS(FactInventory), REMOVEFILTERS(DimDate), DimDate[YearMonth] = Sel)
			VAR OKRows = CALCULATE(COUNTROWS(FactInventory), REMOVEFILTERS(DimDate), DimDate[YearMonth] = Sel, FactInventory[Status] = "OK")
			RETURN DIVIDE(OKRows, TotalRows)
		formatString: 0.0%
		lineageTag: f585599f-e20b-4569-adf0-45b056d0e389

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	/// Sous-titre dynamique du dashboard. A utiliser via Format -> Titre -> fx -> Field value sur un visuel texte ou un titre de page.
	measure 'Dashboard Subtitle' =
			"Dashboard / "
			& SELECTEDVALUE(DimPlant[PlantName], "All Plants")
			& " / "
			& SELECTEDVALUE(DimMachine[MachineType], "All Machines")
			& " / "
			& SELECTEDVALUE(MonthPicker[YearMonth], "All Periods")

	column _Hidden
		dataType: string
		isHidden
		lineageTag: 1c1158c3-d2da-4e04-9077-9b3c53f674cb
		summarizeBy: none
		sourceColumn: _Hidden

		annotation SummarizationSetBy = Automatic

	partition _Measures = m
		mode: import
		source =
				let
				    Source = #table({"_Hidden"}, {{1}})
				in
				    Source

	annotation PBI_ResultType = Table


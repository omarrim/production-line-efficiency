table _Measures
	lineageTag: 5e7995c3-af00-4800-a665-cc2d23cf41a6

	measure Availability = DIVIDE(SUM(FactProduction[OperatingTime_Min]), SUM(FactProduction[PlannedProductionTime_Min]))
		formatString: 0.0%
		lineageTag: c0657d21-0df9-48c8-9190-d99bdb35271b

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure Performance = VAR IdealOutput = SUMX(FactProduction, DIVIDE(FactProduction[OperatingTime_Min], FactProduction[IdealCycleTime_Min])) RETURN DIVIDE(SUM(FactProduction[TotalUnitsProduced]), IdealOutput)
		formatString: 0.0%
		lineageTag: 5b46e3b2-19b8-4233-b9a1-3180859f3fbe

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure Quality = DIVIDE(SUM(FactProduction[GoodUnits]), SUM(FactProduction[TotalUnitsProduced]))
		formatString: 0.0%
		lineageTag: f454b117-5b00-4308-9457-ac881ed630ab

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure OEE = [Availability] * [Performance] * [Quality]
		formatString: 0%
		lineageTag: 3a294ed9-e5be-4dba-97f3-41a87963ee6c

		annotation PBI_FormatHint = {"isCustom":true}

	measure 'OEE PP' = CALCULATE([OEE], DATEADD(DimDate[Date], -30, DAY))
		formatString: 0.0%
		lineageTag: 8d032ea8-306c-4534-b86b-e08fedca5dd4

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'OEE Variation' = [OEE] - [OEE PP]
		formatString: +0.0%;-0.0%;0.0%
		lineageTag: b5dfc0fe-12ac-42bd-801e-aa1223b2b329

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'OEE Variation %' = DIVIDE([OEE Variation], [OEE PP])
		formatString: +0.0%;-0.0%;0.0%
		lineageTag: 4125d1cc-1b0d-4fbc-a9f4-805d68f841bb

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Total Defects' = SUM(FactDefects[DefectCount])
		formatString: #,0
		lineageTag: b6ea0c01-cb1c-4829-933e-8f744fa49db3

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Total Production' = SUM(FactProduction[TotalUnitsProduced])
		formatString: #,0
		lineageTag: 16eaeb3d-3740-4849-bc8a-07f6a2ab1524

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Defect Rate' = DIVIDE([Total Defects], [Total Production])
